<?xml version="1.0" encoding="utf-8"?>
<!-- targetCellWidth/Height (API 31+) and widgetFeatures (API 28+) are skipped on older
     Android: minWidth/minHeight size the widget there, and launcher reconfiguring needs 28+. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:configure="com.hundredwidgets.app.configure.ConfigureActivity"
    android:description="@string/we_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/we_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
